{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable pnpm && pnpm install --filter @workspace/api-server",
  "buildCommand": "node artifacts/api-server/build.vercel.mjs",
  "outputDirectory": "artifacts/claude-design/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}